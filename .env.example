DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgis://hallbooking:hallbooking@localhost:5432/hallbooking_db

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=hallbooking-media
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=ap-south-1

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SENTRY_DSN=

# Public URL of the Next.js frontend (used in emailed links)
FRONTEND_URL=http://localhost:3000

# Local development: uploads to backend/media instead of S3
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage

# GDAL/GEOS library paths (see README "Step 2").
# Windows 11 + OSGeo4W (REQUIRED; use forward slashes and your actual DLL name):
# GDAL_LIBRARY_PATH=C:/OSGeo4W/bin/gdal310.dll
# GEOS_LIBRARY_PATH=C:/OSGeo4W/bin/geos_c.dll
# macOS Apple Silicon + Homebrew (only if Django can't find GDAL):
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib

# docker compose only: host ports (change if already used on your machine)
# DB_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# BACKEND_HOST_PORT=8000
# FRONTEND_HOST_PORT=3000
